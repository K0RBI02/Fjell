root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
# Compose code nests deep; long lines read better than awkward wraps here.
max_line_length = off
# Composables are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# The codebase ends multi-line argument and parameter lists with a comma.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml}]
indent_size = 2
